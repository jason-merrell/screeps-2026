{
  "name": "screeps-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@screeps/driver",
      "isolated-vm"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "build:runtime": "turbo run build --filter=@screeps/runtime",
    "build:scenario": "turbo run build --filter=@screeps/scenario",
    "check": "turbo run lint typecheck test",
    "deploy:screeps": "pnpm build:runtime && node scripts/deploy.mjs",
    "format": "biome format --write .",
    "lab:build": "turbo run build --filter=@screeps/lab",
    "lint": "turbo run lint",
    "replay:bootstrap": "node scripts/replay-bootstrap.mjs",
    "scenario:headless": "turbo run scenario --filter=@screeps/scenario",
    "test": "turbo run test",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "verify:screeps": "node scripts/verify-deploy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/screeps": "3.4.0",
    "esbuild": "0.28.2",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
