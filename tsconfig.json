{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "screeps",
      "vitest/globals"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/runtime/src",
    "packages/runtime/test",
    "scripts"
  ]
}
